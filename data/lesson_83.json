      "start": 694.64,
      "end": 697.56
    },
    {
      "text": "Right.",
      "trans": "右。 (Rù.)",
      "start": 697.56,
      "end": 698.56
    },
    {
      "text": "I think that's a good idea.",
      "trans": "我认为这是一个好主意。",
      "start": 698.56,
      "end": 699.56
    },
