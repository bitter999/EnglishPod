      "start": 139.76,
      "end": 141.6
    },
    {
      "text": "Ten thousand US dollars.",
      "trans": "十万元人民币。",
      "start": 141.6,
      "end": 143.6
    },
    {
      "text": "Two.",
      "trans": "两。",
      "start": 143.6,
      "end": 144.51999999999998
    },
    {
      "text": "The world wildlife foundation.",
      "trans": "世界自然基金会。",
      "start": 144.52,
      "end": 146.84
    },
    {
      "text": "If this is correct, please press one.",
      "trans": "如果这是正确的，那么请按一下。",
      "start": 146.84,
      "end": 148.64000000000001
    },
    {
      "text": "No.",
      "trans": "不。",
      "start": 148.64000000000001,
      "end": 149.64000000000001
    },
    {
      "text": "No.",
      "trans": "没有。",
      "start": 149.64000000000001,
      "end": 150.64000000000001
    },
    {
      "text": "Stupid machine.",
