      "start": 151.64000000000001,
      "end": 152.64000000000001
    },
    {
      "text": "No.",
      "trans": "不。",
      "start": 152.64000000000001,
      "end": 153.64000000000001
    },
    {
      "text": "Confirmed.",
      "trans": "确认。",
      "start": 153.64000000000001,
      "end": 154.64000000000001
    },
    {
      "text": "Thank you for using our bank.",
      "trans": "非常感谢使用我们的银行。",
      "start": 154.64000000000001,
      "end": 155.64000000000001
    },
    {
