      "start": 127.8,
      "end": 129.44
    },
    {
      "text": "Yeah, yeah.",
      "trans": "是的，是的。",
      "start": 129.44,
      "end": 130.44
    },
    {
      "text": "I know what I selected.",
      "trans": "我知道我选的。",
      "start": 130.44,
      "end": 131.44
    },
    {
      "text": "Just give me my money.",
      "trans": "请给我我的钱。",
      "start": 131.44,
      "end": 133.16
    },
