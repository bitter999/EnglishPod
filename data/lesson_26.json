      "start": 107.04,
      "end": 109.08000000000001
    },
    {
      "text": "Trust me Carol.",
      "trans": "英语：信任我，Carol。",
      "start": 109.08000000000001,
      "end": 110.36
    },
    {
      "text": "I'm going to be a new man in one year's time.",
