      "start": 10.200000000000001,
      "end": 14.48
    },
    {
      "text": "appearance.",
      "trans": "外观。",
      "start": 14.48,
      "end": 15.48
    },
    {
      "text": "It's something that everyone has learned before in school describing people.",
      "trans": "英语：它是在学校里每个人都学过描述人的东西。",
      "start": 15.48,
      "end": 19.04
    },
