      "start": 507.52000000000004,
      "end": 512.4
    },
    {
      "text": "Example 1.",
      "trans": "示例1。",
      "start": 512.4,
      "end": 515.04
    },
    {
      "text": "Would you mind cooking dinner tonight?",
      "trans": "英语：你今晚能帮我做饭吗？",
      "start": 515.04,
      "end": 516.6
    },
    {
      "text": "I'll be home late.",
      "trans": "我将晚到家。",
      "start": 516.6,
      "end": 518.6
    },
