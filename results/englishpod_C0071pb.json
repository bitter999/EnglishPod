    {
        "start": 573.96,
        "end": 574.96,
        "english": "Marco.",
        "chinese": "马科斯。"
    },
    {
        "start": 574.96,
        "end": 575.96,
        "english": "All right.",
        "chinese": "好的。"
    },
    {
        "start": 576.24,
        "end": 579.9200000000001,
        "english": "Everyone that listens to this recipe is a non-believer.",
        "chinese": "每个人听这个食谱的人都不是信主。"
    },
    {
        "start": 579.9200000000001,
        "end": 584.0,
        "english": "They say that it is not possible for it to taste good.",
        "chinese": "他们说，它不能尝起来好。"
    },
    {
        "start": 584.0,
        "end": 585.0,
        "english": "Okay.",
        "chinese": "好的。"
    },
    {
        "start": 585.0,
        "end": 586.84,
        "english": "But here's the recipe.",
        "chinese": "但这里有一道菜。"
    },
    {
        "start": 586.84,
        "end": 590.08,
        "english": "You take a liter of beer or maybe half a liter.",
        "chinese": "您用一升或半升的啤酒。"
    },
    {
        "start": 590.08,
        "end": 591.08,
        "english": "So a pint?",
        "chinese": "所以一盏？"
    },
    {
        "start": 591.08,
        "end": 593.48,
        "english": "A pint or a pint and a half.",
        "chinese": "一个半杯或一整杯。"
    },
    {
        "start": 593.48,
        "end": 595.2800000000001,
        "english": "And you put it in the blender.",
        "chinese": "您把它放入了Blender。"
    },
    {
        "start": 595.2800000000001,
        "end": 596.2800000000001,
        "english": "Okay.",
        "chinese": "好的。"
    },
    {
        "start": 596.2800000000001,
        "end": 597.2800000000001,
        "english": "All right.",
        "chinese": "好的。"
    },
    {
        "start": 597.2800000000001,
        "end": 598.88,
        "english": "Now you take two eggs.",
        "chinese": "现在你拿两个鸡蛋。"
    },
    {
        "start": 598.88,
        "end": 599.88,
        "english": "Uh-huh.",
        "chinese": "嗯，哈。"
    },
    {
        "start": 599.88,
        "end": 600.88,
        "english": "Okay.",
        "chinese": "好的。"
    },
    {
        "start": 600.88,
        "end": 601.88,
        "english": "Not cooked, not boiled, anything.",
        "chinese": "不煮，不蒸，什么都没有。"
    },
    {
        "start": 601.88,
        "end": 603.5600000000001,
        "english": "You take two eggs and put them in the blender.",
        "chinese": "你可以用两个鸡蛋放入搅拌机。"
    },
    {
        "start": 603.5600000000001,
        "end": 604.5600000000001,
        "english": "It could be one or two.",
        "chinese": "它可能是或两个。"
