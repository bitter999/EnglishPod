    {
        "start": 604.5600000000001,
        "end": 605.5600000000001,
        "english": "Okay.",
        "chinese": "好的。"
    },
    {
        "start": 605.56,
        "end": 609.3199999999999,
        "english": "And then you take about half a cup of sugar, put it in the blender.",
