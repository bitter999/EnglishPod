    },
    {
        "start": 616.8,
        "end": 619.0799999999999,
        "english": "So a beer milkshake.",
        "chinese": "所以，一个啤酒奶昔。"
    },
    {
        "start": 619.0799999999999,
        "end": 620.4799999999999,
        "english": "Well, it has no milk.",
