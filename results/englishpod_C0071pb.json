        "chinese": "好的。"
    },
    {
        "start": 621.4799999999999,
        "end": 623.4,
        "english": "But it's actually really good.",
        "chinese": "但是它实际上很好。"
    },
    {
        "start": 623.4,
        "end": 625.04,
        "english": "I've prepared it for some people.",
        "chinese": "我准备了一些人。"
