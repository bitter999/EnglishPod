    {
        "start": 743.76,
        "end": 744.76,
        "english": "answer.",
        "chinese": "答案"
    },
    {
        "start": 744.76,
        "end": 745.76,
        "english": "Great.",
        "chinese": "好。"
    },
    {
        "start": 745.76,
        "end": 748.16,
        "english": "So, we hope to see you there, but we're out of time now.",
        "chinese": "所以，我们希望见到你在这里，但时间有限。"
    },
    {
        "start": 748.16,
        "end": 753.28,
        "english": "So we'll see everyone at EnglishPod.com, leave all your questions and of course all the",
        "chinese": "英语：所以我们将见诸于英语Pod.com，留下所有的问题和当然的全部。"
